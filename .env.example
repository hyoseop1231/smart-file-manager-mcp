# Ollama Server Configuration
OLLAMA_BASE_URL=http://192.168.0.106:11434
OLLAMA_FALLBACK_URL=http://192.168.0.107:11434

# Ollama Model Configuration
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_TEXT_MODEL=glm-4.7-flash
OLLAMA_FAST_MODEL=qwen2.5:7b

# Timeout Configuration (seconds)
OLLAMA_CONNECT_TIMEOUT=10
OLLAMA_READ_TIMEOUT=120
OLLAMA_TOTAL_TIMEOUT=180

# File Path Configuration
WATCH_DIRECTORIES=/watch_directories
DB_PATH=/data/db/file-index.db
EMBEDDINGS_PATH=/data/embeddings
METADATA_PATH=/data/metadata

# Service Ports
MULTIMEDIA_API_PORT=8001
REDIS_PORT=16379
PROMETHEUS_PORT=9090
GRAFANA_PORT=3003

# Performance Settings
MAX_WORKERS=4
INDEX_BATCH_SIZE=100

# AI Service Settings
ENABLE_AI_VISION=true
ENABLE_STT=true

# Monitoring
GRAFANA_PASSWORD=admin

# File Processing
EXCLUDE_EXTENSIONS=.log,.tmp,.cache,.pyc
MAX_FILE_SIZE_MB=100
THUMBNAIL_SIZE=medium

# Database
SQLITE_TIMEOUT=30
DB_CONNECTION_POOL_SIZE=10

# Redis Cache
REDIS_MAX_MEMORY=2gb
REDIS_EVICTION_POLICY=allkeys-lru

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
